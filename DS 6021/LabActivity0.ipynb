   "outputs": [],
   "source": [
    "# Clean 'phone_type'\n",
    "# Strip extra spaces and fix capitalization\n",
    "df['phone_type'] = df['phone_type'].astype(str).str.strip().str.title()\n",
    "# Standardize common variations (e.g., 'Apple' or 'Iphone' -> 'iPhone')\n",
    "df['phone_type'] = df['phone_type'].replace({\n",
    "    'Iphone': 'iPhone',\n",
    "    'Android Phone': 'Android',\n",
    "    'Nan': np.nan  # Keep missing values as NaN\n",
    "})\n",
    "\n",
    "# 2. Clean 'used_sql'\n",
    "# Standardize answers to clean 'Yes' or 'No'\n",
    "df['used_sql'] = df['used_sql'].astype(str).str.strip().str.title()\n",
    "df['used_sql'] = df['used_sql'].replace({\n",
    "    'Y': 'Yes',\n",
    "    'N': 'No',\n",
    "    'Nan': np.nan\n",
    "})\n",
    "\n",
    "# 3. Clean 'fav_season'\n",
    "# Strip whitespace and capitalize title-case\n",
    "df['fav_season'] = df['fav_season'].astype(str).str.strip().str.title()\n",
    "df['fav_season'] = df['fav_season'].replace({'Nan': np.nan})\n",
    "\n",
    "# 4. Clean 'temp' \n",
    "# Remove non-numeric characters like \" degrees\", \"F\", so only numbers remain\n",
    "df['temp'] = df['temp'].astype(str).str.extract(r'(\\d+\\.?\\d*)')[0]\n",
    "df['temp'] = pd.to_numeric(df['temp'], errors='coerce')\n"
   ]
  },

   "id": "a7a26373-498d-4f90-8da2-6bf8bade01ed",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Clean 'sleep_hours' (extract numbers, \"7-8\" or \"7.5 hours\" -> numeric float)\n",
    "df['sleep_hours'] = df['sleep_hours'].astype(str).str.extract(r'(\\d+\\.?\\d*)')[0]\n",
    "df['sleep_hours'] = pd.to_numeric(df['sleep_hours'], errors='coerce')\n",
    "\n",
    "# 2. Clean 'states_visited' (extract numeric values)\n",
    "df['states_visited'] = df['states_visited'].astype(str).str.extract(r'(\\d+)')[0]\n",
    "df['states_visited'] = pd.to_numeric(df['states_visited'], errors='coerce')\n",
    "\n",
    "# 3. Clean 'years_for_undergrad' (extract numbers)\n",
    "df['years_for_undergrad'] = df['years_for_undergrad'].astype(str).str.extract(r'(\\d+\\.?\\d*)')[0]\n",
    "df['years_for_undergrad'] = pd.to_numeric(df['years_for_undergrad'], errors='coerce')\n",
    "\n",
    "# 4. Clean 'major' & 'fav_sport' (strip whitespace and standardize casing)\n",
    "df['major'] = df['major'].astype(str).str.strip().str.title()\n",
    "df['major'] = df['major'].replace({'Nan': np.nan})\n",
    "\n",
    "df['fav_sport'] = df['fav_sport'].astype(str).str.strip().str.title()\n",
    "df['fav_sport'] = df['fav_sport'].replace({'Nan': np.nan})\n",
    "\n",
    "# 5. Convert 'timestamp' to proper datetime format\n",
    "df['timestamp'] = pd.to_datetime(df['timestamp'], errors='coerce')\n"
   ]
  },
